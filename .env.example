# Credenciais (preencha no .env - nunca versione o .env)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Fontes
DOCS_DIR=docs
CONTEXTO_DIR=contexto

# Chunking (SPEC onda 2)
CHUNK_SIZE=350
CHUNK_OVERLAP=40

# Embedding (SPEC onda 2)
EMBEDDING_MODEL=text-embedding-3-small

# Retriever (SPEC onda 4 / PRD)
TOP_K=3

# Generation (SPEC onda 5)
LLM_MODEL=claude-opus-5-5
LLM_MAX_TOKENS=16000
LLM_EFFORT=medium
